 case ${RC_CODEC:-x265} in
   x264) x264 --version 2>&1 | grep -q '0.165.' || { echo "wrong x264 on $(hostname): $(command -v x264): $(x264 --version 2>&1 | head -2)"; return 1 2>/dev/null || exit 1; } ;;
